# Copy this file to `.env` in this folder before running locally or deploying.
# `adk deploy agent_engine` reads this .env and ships its values as the
# deployed agent's environment variables.

# Use Vertex AI (not the Gemini Developer API) as the model backend.
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# URL of the deployed MCP server's Streamable HTTP endpoint (from
# deploy/runtime/deploy_mcp_server.sh, or wherever else you deployed it), e.g.:
# MCP_SERVER_URL=https://mcp-demo-server-xxxxxxxxxx.us-central1.run.app/mcp
MCP_SERVER_URL=http://127.0.0.1:8080/mcp

# Whether the agent attaches a Google ID token when calling MCP_SERVER_URL.
#   auto (default) - attach one for any https:// URL, skip it for localhost.
#   on             - always attach one; fail loudly if that's not possible.
#   off            - never attach one (e.g. the Cloud Run service is
#                    deliberately --allow-unauthenticated, or sits behind
#                    an Agent Gateway that handles auth instead).
# MCP_SERVER_AUTH=auto
