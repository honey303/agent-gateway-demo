# Template for a Google-managed Agent Gateway in "Agent-to-Anywhere" (egress)
# mode - it proxies and authorizes the ADK agent's outbound MCP calls.
#
# Render with envsubst before importing, e.g.:
#   AGW_NAME=mcp-gateway PROJECT_ID=my-project REGION=us-central1 \
#     envsubst < deploy/templates/egress_gateway.yaml.tmpl > rendered.yaml
#
# Reference: https://docs.cloud.google.com/gemini-enterprise-agent-platform/govern/gateways/set-up-agent-gateway

name: ${AGW_NAME}
protocols:
  - MCP
googleManaged:
  governedAccessPath: AGENT_TO_ANYWHERE
registries:
  - "//agentregistry.googleapis.com/projects/${PROJECT_ID}/locations/${REGION}"
