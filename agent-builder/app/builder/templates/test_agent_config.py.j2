# Generated by agent-builder from blueprint.yml.
"""Checks the agent in app/agent.py still matches blueprint.yml.

Needs no model access or credentials: it only builds the agent tree and the
function declarations ADK would send to the model.
"""

import json
from pathlib import Path

from google.adk.tools.base_tool import BaseTool
from google.adk.tools.function_tool import FunctionTool

from app.agent import app, root_agent

ROOT_AGENT = {{ root_name | py_str }}
# agent name -> Python function tools it must expose
EXPECTED_FUNCTION_TOOLS = {{ expected | py_repr }}
EVAL_CASE_IDS = {{ eval_ids | py_repr }}
MCP_TOOLSETS = {{ mcp_count }}

PROJECT_ROOT = Path(__file__).resolve().parents[2]


def _agents(agent):
    yield agent
    for sub in agent.sub_agents:
        yield from _agents(sub)


def test_app_wraps_root_agent():
    assert app.root_agent is root_agent
    assert root_agent.name == ROOT_AGENT


def test_agent_tree_matches_blueprint():
    assert {a.name for a in _agents(root_agent)} == set(EXPECTED_FUNCTION_TOOLS)


def test_function_tools_have_valid_declarations():
    for agent in _agents(root_agent):
        functions = [t for t in agent.tools if callable(t) and not isinstance(t, BaseTool)]
        assert sorted(f.__name__ for f in functions) == sorted(
            EXPECTED_FUNCTION_TOOLS[agent.name]
        ), agent.name
        for fn in functions:
            declaration = FunctionTool(fn)._get_declaration()
            assert declaration is not None and declaration.name == fn.__name__


def test_mcp_toolsets_present():
    from google.adk.tools.base_toolset import BaseToolset

    toolsets = [
        t for a in _agents(root_agent) for t in a.tools if isinstance(t, BaseToolset)
    ]
    assert len(toolsets) == MCP_TOOLSETS


def test_eval_dataset_matches_blueprint():
    dataset = json.loads(
        (PROJECT_ROOT / "tests/eval/datasets/basic-dataset.json").read_text()
    )
    assert [c["eval_case_id"] for c in dataset["eval_cases"]] == EVAL_CASE_IDS
