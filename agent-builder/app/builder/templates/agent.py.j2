# --- MCP servers -----------------------------------------------------------
# Streamable HTTP, not stdio: a stdio toolset holds a subprocess pipe, which
# can't be shipped to Agent Runtime or shared across Cloud Run requests.

_ID_TOKENS: dict[str, tuple[str, float]] = {}


def _mcp_auth(url: str, mode: str):
    """Returns a header_provider that attaches a Google ID token for `url`.

    IAM-protected Cloud Run services require one, with the service URL as the
    audience. mode: "auto" = only for https:// URLs, "on" = always (fail if a
    token can't be minted), "off" = never.
    """
    parsed = urlparse(url)
    if mode == "off" or (mode == "auto" and parsed.scheme != "https"):
        return None
    audience = f"{parsed.scheme}://{parsed.netloc}"

    def provider(_context) -> dict[str, str]:
        token, expires_at = _ID_TOKENS.get(audience, ("", 0.0))
        if time.time() >= expires_at:
            import google.auth.transport.requests
            import google.oauth2.id_token

            try:
                token = google.oauth2.id_token.fetch_id_token(
                    google.auth.transport.requests.Request(), audience
                )
            except Exception:
                if mode == "on":
                    raise
                return {}
            # ID tokens last an hour; refresh well before that.
            _ID_TOKENS[audience] = (token, time.time() + 45 * 60)
        return {"Authorization": f"Bearer {token}"}

    return provider
